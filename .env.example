AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
# AWS Bedrock credentials (optional fallback for Claude when direct API hits limits)
# Can use dedicated Bedrock keys or fall back to AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above
AWS_BEDROCK_KEY=
AWS_BEDROCK_SECRET=
AWS_BEDROCK_REGION=us-east-1
# Optional
# HAWKESGEN_PORT=8790
# HAWKESGEN_HOST=127.0.0.1
# HAWKESGEN_DATA_DIR=C:\Projects\hawkesgen\.data
# Comfy.org API key: ComfyUI partner nodes (Seedance, Kling, Veo... templates api_*) bill this account.
COMFY_ORG_API_KEY=
# Google Cloud (docs/cloudrun.md): the Cloud Run GPU backend and a GCS library. Credentials are Application Default
# Credentials: GOOGLE_APPLICATION_CREDENTIALS (on the AWS control server, a workload identity federation config, no
# key), or `gcloud auth application-default login` on a PC. Calls are made as this service account (it holds
# roles/run.invoker on the GPU services); the credentials above need roles/iam.serviceAccountTokenCreator on it.
# GOOGLE_APPLICATION_CREDENTIALS=
# HAWKESGEN_GCP_IMPERSONATE=gen-control@hawkes-staging.iam.gserviceaccount.com
# Hugging Face token, for tools/cloudrun/models-sync.mjs (gated models only).
# HF_TOKEN=
