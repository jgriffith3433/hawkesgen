// Hawkes Gen's address: hawkesgen.ai and www (live), beta.hawkesgen.ai (beta). A Cloudflare Worker that passes every
// request to Gen on Cloud Run (docs/gen-cloudrun.md, "The address"). Deploy from this folder: npx wrangler deploy (the
// first time: npx wrangler login); beta: npx wrangler deploy --env beta.
// gen.hawkesgen.ai and gen-beta.hawkesgen.ai were Gen's names until 2026-10-29; J retired them the same day (their routes
// and DNS records are gone). The names hawkesgen.ai, www and beta.hawkesgen.ai were the customer portal's before it
// moved to hawkesgames.com (hawkesgenwebsite docs/domain-move.md): the Worker still answers the portal's old links there
// (src/index.ts, PORTAL_HOSTS).
{
  "name": "hawkes-gen-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    // hawkesgen.ai and www are a GitHub Pages site since 2026-11-19; Gen answers on api.hawkesgen.ai.
    { "pattern": "api.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" }
  ],
  "vars": {
    // The Cloud Run service's own address (tools/gen-cloudrun/deploy.mjs prints it).
    "GEN_ORIGIN": "https://gen-f6ruen5wfa-uk.a.run.app",
    "PORTAL_ORIGIN": "https://hawkesgames.com",
    "PORTAL_HOSTS": "hawkesgen.ai,www.hawkesgen.ai"
  },
  // Workers Logs (2026-11-02: an email said the account was at 75% of its Workers Logs allowance): no log line per
  // request (invocation_logs off; Cloudflare's own request metrics stay), traces sampled at 1%, and every console.error
  // line kept (logs.head_sampling_rate 1), so errors and Gen's 5xx are all still visible. Nothing logs a routine hit.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  },
  "env": {
    "beta": {
      "routes": [
        { "pattern": "beta.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" }
      ],
      // Cloud Run's deterministic address for the service gen-beta (<service>-<project number>.<region>.run.app).
      "vars": {
        "GEN_ORIGIN": "https://gen-beta-388576319982.us-central1.run.app",
        "PORTAL_ORIGIN": "https://beta.hawkesgames.com",
        "PORTAL_HOSTS": "beta.hawkesgen.ai"
      }
    }
  }
}
