// gen.hawkesgen.ai: a Cloudflare Worker that passes every request to Hawkes Gen on Cloud Run (docs/gen-cloudrun.md,
// "The address"). Deploy from this folder: npx wrangler deploy (the first time: npx wrangler login).
// The beta lane (gen-beta.hawkesgen.ai -> the gen-beta service): npx wrangler deploy --env beta
// hawkesgen.ai and www (live) and beta.hawkesgen.ai (beta) were the customer portal's, which moved to hawkesgames.com
// (docs/domain-move.md): they are Gen's now, and the Worker still answers the portal's old links there (src/index.ts,
// PORTAL_HOSTS). Their routes do nothing while those names are DNS-only records to Firebase: the move's last step makes
// them proxied `AAAA 100::` records, and from then on this Worker has them.
{
  "name": "hawkes-gen-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "gen.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
    { "pattern": "www.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" }
  ],
  "vars": {
    // The Cloud Run service's own address (tools/gen-cloudrun/deploy.mjs prints it).
    "GEN_ORIGIN": "https://gen-f6ruen5wfa-uk.a.run.app",
    "PORTAL_ORIGIN": "https://hawkesgames.com",
    "PORTAL_HOSTS": "hawkesgen.ai,www.hawkesgen.ai"
  },
  "observability": { "enabled": true },
  "env": {
    "beta": {
      "routes": [
        { "pattern": "gen-beta.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" },
        { "pattern": "beta.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" }
      ],
      // Cloud Run's deterministic address for the service gen-beta (<service>-<project number>.<region>.run.app).
      "vars": {
        "GEN_ORIGIN": "https://gen-beta-388576319982.us-central1.run.app",
        "PORTAL_ORIGIN": "https://beta.hawkesgames.com",
        "PORTAL_HOSTS": "beta.hawkesgen.ai"
      }
    }
  }
}
