// cdn.hawkesgen.ai: Gen's library files (sha256/<hash>, the keys src/storage.ts writes) from its private bucket, cached
// at Cloudflare's edge for a year (a hash's bytes never change), fetched through Gen's /cdn route (no key anywhere: the
// Google organization forbids service-account keys). Deploy from this folder: npx wrangler deploy.
{
  "name": "hawkes-gen-cdn",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "cdn.hawkesgen.ai/*", "zone_name": "hawkesgen.ai" }],
  "vars": { "GEN_ORIGIN": "https://gen-f6ruen5wfa-uk.a.run.app" },
  // Workers Logs (2026-11-02: an email said the account was at 75% of its Workers Logs allowance): no log line per
  // request (invocation_logs off; Cloudflare's own request metrics stay), traces sampled at 1%, and every console.error
  // line kept (logs.head_sampling_rate 1), so errors and Gen's 5xx are all still visible. Nothing logs a routine hit.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  }
}
