#!/bin/bash
# Git credential helper on the control server: GitHub access with the token from the hawkes/github secret
# (fetched into /run/hawkes/github.env, in memory, by hawkes-secrets.service). Configured for github.com only.
[ "$1" = "get" ] || exit 0
[ -r /run/hawkes/github.env ] || exit 0
. /run/hawkes/github.env
[ -n "$GITHUB_TOKEN" ] || exit 0
echo "username=x-access-token"
echo "password=$GITHUB_TOKEN"
