      "kind": "image",
      "required": true,
      "description": "The front view",
      "targets": [
        [
          "56",
          "image"
        ]
      ]
    },
    "image2": {
      "kind": "image",
      "required": true,
      "description": "Another view (side or back)",
      "targets": [
        [
          "80",
          "image"
        ]
      ]
    }
  },
  "params": {
    "seed": {
      "type": "integer",
      "min": 0,
      "max": 281474976710656,
