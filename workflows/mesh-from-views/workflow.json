{
  "id": "mesh.from-views",
  "version": 1,
  "title": "3D mesh from several views",
  "description": "A 3D mesh (GLB) from several views of the same object (Hunyuan3D 2.0 multi-view). Better shape than mesh.from-image when you have a front and a side, e.g. from image.angles. Shape only; texture it with mesh.textured or in Blender.",
  "family": "hunyuan3d-mv",
  "output": "mesh",
  "models": [
    {
      "file": "hunyuan3d-dit-v2-mv_fp16.safetensors",
