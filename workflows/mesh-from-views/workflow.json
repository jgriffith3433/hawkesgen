      "advanced": true,
      "targets": [
        [
          "3",
          "steps"
        ]
      ]
    },
    "cfg": {
      "type": "number",
      "min": 0,
      "max": 30,
      "default": 7.5,
      "advanced": true,
      "targets": [
        [
          "3",
          "cfg"
        ]
      ]
    }
  },
  "outputs": [
    "83"
  ],
