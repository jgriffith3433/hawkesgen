    "height": {
      "type": "integer",
      "min": 256,
      "max": 2048,
      "default": 1024,
      "targets": [
        [
          "57:13",
          "height"
        ]
      ]
    },
    "seed": {
      "type": "integer",
      "min": 0,
      "max": 281474976710656,
