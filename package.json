{
  "name": "hawkesgen",
  "version": "0.1.0",
  "private": true,
  "description": "Hawkes Gen: one local service for every game's generative AI (AWS GPU fleet + ComfyUI, ElevenLabs, Claude, local tools).",
  "type": "module",
  "bin": {
    "hawkesgen": "bin/hawkesgen.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=src src/server.ts",
    "cli": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-ec2": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-service-quotas": "^3.1151.0",
    "@aws-sdk/client-sts": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
